     "children": [
      {
       "kind": "Item",
       "id": "custom-103",
       "label": "重启资源管理器",
       "badge": "",
       "accel": "",
       "shortcut": "",
       "hotkey": "",
       "show_badges": null,
       "show_shortcuts": null,
       "enabled": true,
       "actions": [
        {
         "kind": "Run",
         "value": "%ComSpec% /c \"taskkill /f /im explorer.exe & start explorer.exe\"",
         "delay_ms": 0
        }
       ],
       "children": []
      },
      {
       "kind": "Item",
       "id": "custom-104",
       "label": "关闭显示器",
       "badge": "",
       "accel": "",
       "shortcut": "",
       "hotkey": "",
       "show_badges": null,
       "show_shortcuts": null,
       "enabled": true,
       "actions": [
        {
         "kind": "Run",
         "value": "%ComSpec% /c powershell (Add-Type '[DllImport(\\\"user32.dll\\\")]^public static extern int PostMessage(int hWnd, int hMsg, int wParam, int lParam);' -Name a -Pas)::PostMessage(-1,0x0112,0xF170,2)",
         "delay_ms": 0
        }
       ],
       "children": []
      },
      {
       "kind": "Item",
       "id": "custom-105",
       "label": "系统锁屏",
       "badge": "",
       "accel": "",
       "shortcut": "",
       "hotkey": "",
       "show_badges": null,
       "show_shortcuts": null,
       "enabled": true,
       "actions": [
        {
         "kind": "Run",
         "value": "rundll32.exe user32.dll LockWorkStation",
         "delay_ms": 0
        }
       ],
       "children": []
      },
      {
